{
  "_comment": "기존 ~/.claude/settings.json 의 hooks 안에 아래 SessionStart / SessionEnd 블록을 병합하세요. node 경로는 본인 사용자명에 맞게 수정.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"c:/Users/<사용자명>/.claude/hooks/session-restore.js\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"c:/Users/<사용자명>/.claude/hooks/session-save-raw.js\""
          }
        ]
      }
    ]
  }
}
